local floatPulseId = 0
local function startFloatPulse()
    floatPulseId += 1
    local id = floatPulseId
    task.spawn(function()
        while floatPulseId == id do
            pulseRing.Size = UDim2.fromOffset(FLOAT_SIZE, FLOAT_SIZE)
            pulseStroke.Transparency = 0.2
            tween(pulseRing, 1.6, { Size = UDim2.fromOffset(FLOAT_SIZE + 40, FLOAT_SIZE + 40) })
            tween(pulseStroke, 1.6, { Transparency = 1 })
            task.wait(1.8)
        end
    end)
end
local function stopFloatPulse()
    floatPulseId += 1
    pulseStroke.Transparency = 1
end

