    or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)

local uiOpen    = false
local uiBusy    = false
local uiLoaded  = false

local function openUI()
    if uiOpen or uiBusy then return end
    uiBusy = true
    uiOpen = true

    stopFloatPulse()
    tween(floatBtn, 0.22, { Size = UDim2.fromOffset(0, 0) }, Enum.EasingStyle.Quint, Enum.EasingDirection.In)

    local s = targetScale
    main.GroupTransparency = 1
    aura.GroupTransparency = 1
    uiScale.Scale = s * 0.9
    shell.Visible = true
    tween(main, 0.35, { GroupTransparency = 0 })
    tween(aura, 0.7, { GroupTransparency = 0 })
    tween(uiScale, 0.55, { Scale = s }, Enum.EasingStyle.Back)

    task.delay(0.55, function()
        floatBtn.Visible = false
        uiBusy = false
    end)
end

local function closeUI()
    if not uiOpen or uiBusy then return end
    uiBusy = true
    uiOpen = false
    resizing, dragging = false, false

    local s = targetScale
    uiScale.Scale = s
    tween(main, 0.28, { GroupTransparency = 1 })
    tween(aura, 0.35, { GroupTransparency = 1 })
    tween(uiScale, 0.3, { Scale = s * 0.9 }, Enum.EasingStyle.Quint, Enum.EasingDirection.In)

    task.delay(0.32, function()
        shell.Visible = false
        uiScale.Scale = s

        floatBtn.Size = UDim2.fromOffset(0, 0)
        floatBtn.Visible = true
        tween(floatBtn, 0.5, { Size = UDim2.fromOffset(FLOAT_SIZE, FLOAT_SIZE) }, Enum.EasingStyle.Back)
        startFloatPulse()
        uiBusy = false
    end)
end

local function toggleUI()
    if uiOpen then closeUI() else openUI() end
end

closeBtn.Activated:Connect(closeUI)

local fDrag, fMoved, fStart, fPos = false, false, nil, nil
floatBtn.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        fDrag, fMoved = true, false
        fStart = input.Position
        fPos = floatBtn.Position
    end
end)
UIS.InputChanged:Connect(function(input)
    if fDrag and (input.UserInputType == Enum.UserInputType.MouseMovement
    or input.UserInputType == Enum.UserInputType.Touch) then
        local d = input.Position - fStart
        if d.Magnitude > 6 then fMoved = true end
        if fMoved then
            floatBtn.Position = UDim2.new(fPos.X.Scale, fPos.X.Offset + d.X,
                                           fPos.Y.Scale, fPos.Y.Offset + d.Y)
        end
    end
end)
UIS.InputEnded:Connect(function(input)
    if fDrag and (input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch) then
        fDrag = false
        if not fMoved then openUI() end
    end
end)

