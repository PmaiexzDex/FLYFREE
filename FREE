local dotPulseId = 0

refreshUI = function()
    if flying then
        swapFlyText("FLY", Color3.new(1, 1, 1))
        tween(stopLayer, 0.45, { BackgroundTransparency = 0 })
        tween(flyStroke, 0.4, { Color = C.danger })
        tween(mainStroke, 0.5, { Color = C.success })
        tween(floatStroke, 0.5, { Color = C.success })
        status.Text = "Flying"
        tween(status, 0.3, { TextColor3 = C.success })
        tween(statusDot, 0.3, { BackgroundColor3 = C.success })
        for _, l in ipairs(auraLayers) do
            tween(l, 0.7, { BackgroundColor3 = AURA_FLY })
        end

        dotPulseId += 1
        local id = dotPulseId
        task.spawn(function()
            while flying and dotPulseId == id do
                tween(statusDot, 0.7, { BackgroundTransparency = 0.65 }, Enum.EasingStyle.Sine)
                task.wait(0.7)
                tween(statusDot, 0.7, { BackgroundTransparency = 0 }, Enum.EasingStyle.Sine)
                task.wait(0.7)
            end
            statusDot.BackgroundTransparency = 0
        end)
    else
        dotPulseId += 1
        swapFlyText("FLY", C.text)
        tween(stopLayer, 0.45, { BackgroundTransparency = 1 })
        tween(flyStroke, 0.4, { Color = C.accent2 })
        tween(mainStroke, 0.5, { Color = C.accent2 })
        tween(floatStroke, 0.5, { Color = C.accent2 })
        status.Text = "Idle"
        tween(status, 0.3, { TextColor3 = C.textDim })
        tween(statusDot, 0.3, { BackgroundColor3 = C.textDim, BackgroundTransparency = 0 })
        for _, l in ipairs(auraLayers) do
            tween(l, 0.7, { BackgroundColor3 = AURA_IDLE })
        end
    end
end
refreshUI()

