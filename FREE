UIS.InputBegan:Connect(function(i, gp)
    if capturingKey then
        if tick() - captureStart < 0.2 then return end
        if gp and i.UserInputType == Enum.UserInputType.Keyboard then return end

        local uiType = i.UserInputType
        if uiType == Enum.UserInputType.Keyboard then
            if i.KeyCode == Enum.KeyCode.Unknown or i.KeyCode == Enum.KeyCode.Escape then
                resetKeybindUI()
                return
            end
            TOGGLE_KEY = i.KeyCode
            TOGGLE_MOUSE = nil
        elseif uiType == Enum.UserInputType.MouseButton1
            or uiType == Enum.UserInputType.MouseButton2
            or uiType == Enum.UserInputType.MouseButton3 then
            TOGGLE_MOUSE = uiType
        else
            resetKeybindUI()
            return
        end

        resetKeybindUI()
        return
    end

    if gp then return end
    if typing then return end

    if uiLoaded and i.UserInputType == Enum.UserInputType.Keyboard and i.KeyCode == UI_HIDE_KEY then
        toggleUI()
        return
    end

    local isToggle
    if TOGGLE_MOUSE then
        isToggle = (i.UserInputType == TOGGLE_MOUSE)
    else
        isToggle = (i.UserInputType == Enum.UserInputType.Keyboard
                    and i.KeyCode == TOGGLE_KEY)
    end

    if isToggle then
        if flying then stopFly() else startFly() end
    end
end)

local sliderDragging = false
local function updateSlider(mouseX)
    local ax = slider.AbsolutePosition.X
    local aw = slider.AbsoluteSize.X
    local alpha = math.clamp((mouseX - ax) / aw, 0, 1)
    local ratio = MAX_SPEED / MIN_SPEED
    setSpeedValue(MIN_SPEED * (ratio ^ alpha))
end
hitbox.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        sliderDragging = true
        updateSlider(input.Position.X)
        tween(knob, 0.2, { Size = UDim2.fromOffset(18, 18) }, Enum.EasingStyle.Back)
    end
end)
UIS.InputChanged:Connect(function(input)
    if sliderDragging and (input.UserInputType == Enum.UserInputType.MouseMovement
    or input.UserInputType == Enum.UserInputType.Touch) then
        updateSlider(input.Position.X)
    end
end)
UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        if sliderDragging then
            tween(knob, 0.25, { Size = UDim2.fromOffset(14, 14) }, Enum.EasingStyle.Back)
        end
        sliderDragging = false
    end
end)

local auraClock = 0

local renderConn = RunService.RenderStepped:Connect(function(dt)
    if math.abs(targetAlpha - dispAlpha) > 0.0003 then
        dispAlpha += (targetAlpha - dispAlpha) * (1 - math.exp(-24 * dt))
        fill.Size     = UDim2.new(dispAlpha, 0, 1, 0)
        knob.Position = UDim2.new(dispAlpha, 0, 0.5, 0)
    elseif dispAlpha ~= targetAlpha then
        dispAlpha = targetAlpha
        fill.Size     = UDim2.new(dispAlpha, 0, 1, 0)
        knob.Position = UDim2.new(dispAlpha, 0, 0.5, 0)
    end

    if not shell.Visible then return end

    local p = shell.Position
    local dx, dy = tgtX - p.X.Offset, tgtY - p.Y.Offset
    if math.abs(dx) > 0.05 or math.abs(dy) > 0.05 then
        local a = 1 - math.exp(-28 * dt)
        shell.Position = UDim2.new(p.X.Scale, p.X.Offset + dx * a,
                                   p.Y.Scale, p.Y.Offset + dy * a)
    end

    if uiOpen and not uiBusy then
        local ds = targetScale - uiScale.Scale
        if math.abs(ds) > 0.0005 then
            uiScale.Scale += ds * (1 - math.exp(-18 * dt))
        end
    end

    auraClock += dt * (flying and 3.2 or 2)
    local amp = flying and 0.035 or 0.02
    auraScale.Scale = 1 + amp * math.sin(auraClock)
end)

local wdControlsAccum = 0

RunService.PreSimulation:Connect(function(dt)
    if not flying then return end

    if not root or not root.Parent or not hum or not hum.Parent then
        if not ensureChar() then
            stopFly()
            return
        end
    end

    if not bv or bv.Parent ~= root then
        if bv then pcall(function() bv:Destroy() end) end
        bv = makeBV()
    end
    if not bg or bg.Parent ~= root then
        if bg then pcall(function() bg:Destroy() end) end
        bg = makeBG()
    end

    hum.PlatformStand = true

    wdControlsAccum += dt
    if wdControlsAccum >= 0.5 then
        wdControlsAccum = 0
        if Controls then pcall(function() Controls:Disable() end) end
    end

    local cam = workspace.CurrentCamera
    if not cam then return end
    local cf = cam.CFrame

    local dir = Vector3.zero
    if not typing then
        if UIS:IsKeyDown(Enum.KeyCode.W) then dir += cf.LookVector  end
        if UIS:IsKeyDown(Enum.KeyCode.S) then dir -= cf.LookVector  end
        if UIS:IsKeyDown(Enum.KeyCode.D) then dir += cf.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.A) then dir -= cf.RightVector end
    end

    local target = dir.Magnitude > 0.01 and dir.Unit * SPEED or Vector3.zero
    curVel = curVel:Lerp(target, 1 - math.exp(-VEL_SMOOTH * dt))
    bv.Velocity = curVel
end)

