    local function setErr(msg, isError)
        err.TextColor3 = isError and Color3.fromRGB(170, 55, 55) or C.textDim
        err.Text = msg
    end

    local function tryAuth()
        if authorized or checking then return end

        local rawId   = (idInput.Text   or ""):gsub("%s", "")
        local rawUser = (userInput.Text or ""):gsub("^%s+", ""):gsub("%s+$", "")

        local n = tonumber(rawId)
        if not n or n < 1 then
            setErr("Please enter a valid numeric UserId", true)
            shake()
            return
        end
        if rawUser == "" then
            setErr("Please enter your Roblox Username", true)
            shake()
            return
        end
        n = math.floor(n)

        checking = true
        setErr("Verifying with Roblox...", false)
        submit.Text = "Checking..."
        submit.BackgroundColor3 = C.accent2

        task.spawn(function()
            -- ดึงชื่อจริงของ ID จาก Roblox
            local ok, realName = pcall(function()
                return Players:GetNameFromUserIdAsync(n)
            end)

            if authorized then return end
            checking = false

            -- (1) ID มีจริงไหม
            if not ok or type(realName) ~= "string" or realName == "" then
                setErr("This Roblox UserId does not exist", true)
                submit.Text = "Continue"
                submit.BackgroundColor3 = C.accent
                shake()
                return
            end

            -- (2) Username ตรงกับ ID ไหม (เทียบแบบไม่สนตัวพิมพ์)
            if string.lower(realName) ~= string.lower(rawUser) then
                setErr("UserId and Username do not match", true)
                submit.Text = "Continue"
                submit.BackgroundColor3 = C.accent
                shake()
                return
            end

            -- ✅ ผ่าน — ทั้งคู่ถูกต้องและตรงกัน
            authorized = true
            err.TextColor3 = Color3.fromRGB(55, 130, 80)
            err.Text = "✓ Verified: " .. realName
            submit.Text = "✓ Login Success"
            submit.BackgroundColor3 = C.success

            TweenService:Create(loginCard, TweenInfo.new(0.35, Enum.EasingStyle.Quint, Enum.EasingDirection.In), {
                Size = UDim2.fromOffset(LW * 0.9, LH * 0.9),
            }):Play()
            TweenService:Create(loginCard, TweenInfo.new(0.35), { BackgroundTransparency = 1 }):Play()
            TweenService:Create(ls, TweenInfo.new(0.35), { Transparency = 1 }):Play()
            TweenService:Create(dim, TweenInfo.new(0.35), { BackgroundTransparency = 1 }):Play()
        end)
    end

    submit.MouseButton1Click:Connect(tryAuth)
    idInput.FocusLost:Connect(function(enterPressed)
        if enterPressed then tryAuth() end
    end)
    userInput.FocusLost:Connect(function(enterPressed)
        if enterPressed then tryAuth() end
    end)

    -- block flow จนกว่าจะ authorize
    while not authorized do
        task.wait(0.1)
    end
    task.wait(0.4)
    loginGui:Destroy()
